<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SMAScheduler</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SMAPlannerForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SMAPlannerForm.Designer.vb">
      <DependentUpon>SMAPlannerForm.vb</DependentUpon>
    </Compile>
    <Compile Update="SMASchedulerForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="SMASchedulerForm.Designer.vb">
      <DependentUpon>SMASchedulerForm.vb</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="SMAPlannerForm.resx">
      <DependentUpon>SMAPlannerForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="SMASchedulerForm.resx">
      <DependentUpon>SMASchedulerForm.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

</Project>
